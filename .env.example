# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Channel ID: either @YourChannelName or numeric ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=@YourChannelName

# Trading pairs to scan (comma-separated)
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# Exchange to pull data from (any CCXT-supported exchange)
EXCHANGE=binance

# Scan interval in minutes
SCAN_INTERVAL_MINUTES=5

# Timeframes to analyze (comma-separated)
TIMEFRAMES=1h,4h

# Minimum number of indicators that must agree to emit a signal
MIN_CONFLUENCE=2

# Log level
LOG_LEVEL=INFO
